# 开发环境配置

# 应用标题
VITE_APP_TITLE=Apple ID 自动解锁系统 - 开发环境

# API 基础 URL（后端服务地址）
VITE_API_BASE_URL=http://localhost:8000

# API 路径前缀
VITE_API_PREFIX=/api/v1

# 环境
VITE_ENV=development

# 是否启用 Mock（如果后端未启动，可以开启 Mock）
VITE_USE_MOCK=false

# Token 存储 key
VITE_TOKEN_KEY=appleid_access_token
VITE_REFRESH_TOKEN_KEY=appleid_refresh_token

# 是否启用路由动画
VITE_ENABLE_ROUTE_TRANSITION=true

# 是否启用页面加载进度条
VITE_ENABLE_PROGRESS=true

# 上传文件大小限制（MB）
VITE_UPLOAD_SIZE_LIMIT=10

# 日志级别（debug | info | warn | error）
VITE_LOG_LEVEL=debug
