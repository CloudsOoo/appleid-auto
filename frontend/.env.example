# 环境变量配置示例
# 复制此文件为 .env.development 或 .env.production 并修改相应配置

# ================================
# 应用配置
# ================================
# 应用标题
VITE_APP_TITLE=Apple ID 自动解锁系统

# ================================
# API 配置
# ================================
# API 基础 URL（后端服务地址）
# 开发环境示例：http://localhost:8000
# 生产环境示例：https://api.yourdomain.com
VITE_API_BASE_URL=http://localhost:8000

# API 路径前缀
VITE_API_PREFIX=/api/v1

# ================================
# 环境配置
# ================================
# 环境（development | production）
VITE_ENV=development

# 是否启用 Mock 数据（开发时如果后端未启动可以开启）
VITE_USE_MOCK=false

# ================================
# Token 配置
# ================================
# Token 存储 key（建议生产环境修改为唯一值）
VITE_TOKEN_KEY=appleid_access_token
VITE_REFRESH_TOKEN_KEY=appleid_refresh_token

# ================================
# UI 配置
# ================================
# 是否启用路由动画
VITE_ENABLE_ROUTE_TRANSITION=true

# 是否启用页面加载进度条
VITE_ENABLE_PROGRESS=true

# ================================
# 文件上传配置
# ================================
# 上传文件大小限制（MB）
VITE_UPLOAD_SIZE_LIMIT=10

# ================================
# 日志配置
# ================================
# 日志级别（debug | info | warn | error）
# 开发环境建议：debug
# 生产环境建议：error
VITE_LOG_LEVEL=debug
