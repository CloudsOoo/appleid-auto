# ============================================================
# Apple ID 自动解锁系统 - 生产环境变量配置
# 复制此文件为 .env.prod 并修改相应值
# ============================================================

# 数据库配置
DB_USER=postgres
DB_PASSWORD=your-secure-password-here
DB_NAME=appleid_auto

# 安全密钥 (必须修改!)
SECRET_KEY=your-64-character-secret-key-here
JWT_SECRET_KEY=your-64-character-jwt-secret-key-here
JWT_EXPIRE=60

# CORS 配置 (修改为你的域名)
CORS_ORIGINS=["https://yourdomain.com","https://www.yourdomain.com"]

# Flower 监控面板认证
FLOWER_USER=admin
FLOWER_PASSWORD=your-secure-flower-password

# 管理员配置
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=your-secure-admin-password
