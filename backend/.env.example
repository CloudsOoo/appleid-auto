# ========================================
# Apple ID 自动解锁系统 - 环境变量配置示例
# ========================================
#
# 使用方法：
# 1. 复制此文件为 .env
#    cp .env.example .env
#
# 2. 修改以下配置项（特别是标记为 [必改] 的项）
#
# 3. 生成随机密钥：
#    python3 -c "import secrets; print(secrets.token_urlsafe(64))"
#
# ========================================

# ========================================
# 应用配置
# ========================================

# 应用名称
APP_NAME=Apple ID Auto

# 应用版本
APP_VERSION=1.0.0

# 运行环境：development / production
APP_ENV=development

# 调试模式：True / False（生产环境必须设为 False）
DEBUG=True

# [必改] 应用密钥（用于加密敏感数据）
# 生成方式：python3 -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=your-secret-key-here-please-change-it

# ========================================
# 服务器配置
# ========================================

# 服务器监听地址（0.0.0.0 表示监听所有网卡）
HOST=0.0.0.0

# 服务器端口
PORT=8000

# Worker 进程数（生产环境建议设置为 CPU 核心数 * 2 + 1）
WORKERS=4

# ========================================
# 数据库配置
# ========================================

# [必改] 数据库连接 URL
# 格式：postgresql+asyncpg://用户名:密码@主机:端口/数据库名
# 示例：postgresql+asyncpg://postgres:password@localhost:5432/appleid_auto
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/appleid_auto

# 数据库连接池大小
DATABASE_POOL_SIZE=20

# 数据库连接池最大溢出数
DATABASE_MAX_OVERFLOW=10

# ========================================
# Redis 配置
# ========================================

# Redis 连接 URL（用于缓存和会话）
# 格式：redis://主机:端口/数据库编号
REDIS_URL=redis://redis:6379/0

# Redis 密码（如果 Redis 设置了密码）
# REDIS_PASSWORD=

# ========================================
# Celery 配置
# ========================================

# Celery Broker URL（消息队列）
CELERY_BROKER_URL=redis://redis:6379/1

# Celery Result Backend（结果存储）
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ========================================
# JWT 配置
# ========================================

# [必改] JWT 密钥（用于生成和验证 JWT Token）
# 生成方式：python3 -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=your-jwt-secret-key-here-please-change-it

# JWT 加密算法
JWT_ALGORITHM=HS256

# JWT Access Token 过期时间（分钟）
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# JWT Refresh Token 过期时间（天）
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ========================================
# CORS 配置
# ========================================

# 允许跨域的源（多个源用逗号分隔）
# 生产环境应该设置为具体的前端域名
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost

# ========================================
# 文件上传配置
# ========================================

# 最大上传文件大小（字节）
# 10485760 = 10MB
MAX_UPLOAD_SIZE=10485760

# 上传文件存储目录
UPLOAD_DIR=./uploads

# ========================================
# 日志配置
# ========================================

# 日志级别：DEBUG / INFO / WARNING / ERROR / CRITICAL
LOG_LEVEL=INFO

# 日志文件路径
LOG_FILE=./logs/app.log

# ========================================
# 限流配置
# ========================================

# 是否启用限流：True / False
RATE_LIMIT_ENABLED=True

# 每分钟允许的请求数
RATE_LIMIT_PER_MINUTE=60

# ========================================
# 邮件配置（可选）
# ========================================

# SMTP 服务器地址
# SMTP_HOST=smtp.gmail.com

# SMTP 端口
# SMTP_PORT=587

# SMTP 用户名
# SMTP_USER=your-email@gmail.com

# SMTP 密码
# SMTP_PASSWORD=your-app-password

# 发件人邮箱
# EMAIL_FROM=noreply@appleid-auto.local

# ========================================
# Apple API 配置
# ========================================

# Apple API 请求超时时间（秒）
APPLE_API_TIMEOUT=30

# Apple API 最大重试次数
APPLE_API_MAX_RETRIES=3

# ========================================
# 代理配置
# ========================================

# 代理健康检查间隔（秒）
# 300 = 5分钟
PROXY_CHECK_INTERVAL=300

# 代理测试超时时间（秒）
PROXY_TIMEOUT=10

# ========================================
# 节点配置
# ========================================

# 节点心跳上报间隔（秒）
# 60 = 1分钟
NODE_HEARTBEAT_INTERVAL=60

# 节点离线阈值（秒）
# 180 = 3分钟（超过此时间未上报心跳则判定为离线）
NODE_OFFLINE_THRESHOLD=180

# ========================================
# 任务配置
# ========================================

# 默认账号检测间隔（秒）
# 3600 = 1小时
DEFAULT_CHECK_INTERVAL=3600

# 最大解锁重试次数
MAX_UNLOCK_RETRIES=3

# ========================================
# 安全配置
# ========================================

# 最大登录尝试次数
MAX_LOGIN_ATTEMPTS=5

# 登录尝试超时时间（秒）
# 300 = 5分钟
LOGIN_ATTEMPT_TIMEOUT=300

# 卡密最大尝试次数
CARD_MAX_ATTEMPTS=3

# 卡密尝试超时时间（秒）
# 3600 = 1小时
CARD_ATTEMPT_TIMEOUT=3600

# ========================================
# HTML 过滤配置
# ========================================

# 允许的 HTML 标签（逗号分隔）
ALLOWED_HTML_TAGS=div,span,p,a,img,h1,h2,h3,h4,h5,h6,ul,ol,li,br,hr,strong,em,code,pre,blockquote

# 允许的 HTML 属性（逗号分隔）
ALLOWED_HTML_ATTRIBUTES=class,id,style,href,src,alt,title

# ========================================
# 分享页配置
# ========================================

# 默认分享页模板
SHARE_PAGE_DEFAULT_TEMPLATE=default

# 分享页自定义 HTML 最大大小（字节）
# 102400 = 100KB
SHARE_PAGE_MAX_CUSTOM_HTML_SIZE=102400

# ========================================
# 管理员配置
# ========================================

# [必改] 默认管理员用户名
ADMIN_USERNAME=admin

# [必改] 默认管理员邮箱
ADMIN_EMAIL=admin@appleid-auto.local

# [必改] 默认管理员密码（首次启动后请立即修改）
ADMIN_PASSWORD=Admin@123456
