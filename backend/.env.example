# 应用配置
APP_NAME=Apple ID Auto
APP_VERSION=1.0.0
APP_ENV=development
DEBUG=True
SECRET_KEY=your-secret-key-here-change-in-production

# 服务器配置
HOST=0.0.0.0
PORT=8000
WORKERS=4

# 数据库配置
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/appleid_auto
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# Redis 配置
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=

# Celery 配置
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# JWT 配置
JWT_SECRET_KEY=your-jwt-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS 配置
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# 文件上传
MAX_UPLOAD_SIZE=10485760
UPLOAD_DIR=./uploads

# 日志配置
LOG_LEVEL=INFO
LOG_FILE=./logs/app.log

# 限流配置
RATE_LIMIT_ENABLED=True
RATE_LIMIT_PER_MINUTE=60

# 邮件配置（可选）
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-password
EMAIL_FROM=noreply@appleid-auto.com

# Apple API 配置
APPLE_API_TIMEOUT=30
APPLE_API_MAX_RETRIES=3

# 代理配置
PROXY_CHECK_INTERVAL=300
PROXY_TIMEOUT=10

# 节点配置
NODE_HEARTBEAT_INTERVAL=60
NODE_OFFLINE_THRESHOLD=180

# 任务配置
DEFAULT_CHECK_INTERVAL=3600
MAX_UNLOCK_RETRIES=3

# 安全配置
MAX_LOGIN_ATTEMPTS=5
LOGIN_ATTEMPT_TIMEOUT=300
CARD_MAX_ATTEMPTS=3
CARD_ATTEMPT_TIMEOUT=3600

# HTML 过滤白名单
ALLOWED_HTML_TAGS=div,span,p,a,img,h1,h2,h3,h4,h5,h6,ul,ol,li,br,hr,strong,em,code,pre,blockquote
ALLOWED_HTML_ATTRIBUTES=class,id,style,href,src,alt,title

# 分享页配置
SHARE_PAGE_DEFAULT_TEMPLATE=default
SHARE_PAGE_MAX_CUSTOM_HTML_SIZE=102400

# 管理员配置
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@appleid-auto.local
ADMIN_PASSWORD=Admin@123456
